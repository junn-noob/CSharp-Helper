<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net472;net8.0-windows;net10.0-windows</TargetFrameworks>
    <Nullable>disable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>ExamHelper</RootNamespace>
    <AssemblyName>ExamHelper</AssemblyName>
    
    <!-- Thông tin Package cho Public Release -->
    <Version>1.0.0</Version>
    <Authors>ExamHelper Community</Authors>
    <Company>ExamHelper</Company>
    <Product>ExamHelper Pro</Product>
    <Description>Thư viện C# WinForms chuyên dụng tối ưu tốc độ làm bài thi thực hành và các ứng dụng quản lý dữ liệu với SQL Server.</Description>
    <PackageTags>winforms;sqlserver;crud;validation;helper;ado-net;filter;grid;combobox</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Data.SqlClient" Version="4.8.6" />
  </ItemGroup>

</Project>
